{
  "schema_version": "validation_jobs_v1",
  "description": "Compatibility JSON profile mirroring the retained Jun25/Jun26 patient-runner validation surface. Prefer TOML for hand-edited profiles.",
  "defaults": {
    "abs_tol": 1e-8,
    "rel_tol": 1e-6,
    "write_outputs": true,
    "write_assembled_tables": true
  },
  "runs": {
    "jun25_205540_single_shot": "../Data/Output data/MC_sim_out- Date-Jun-25-2026 Time-20,55,40 - standard-run - inputs-dicom-457_mr-adc-1_mr-t2-0_rtdose-4_rtplan-4_rtstruct-4_us-4",
    "jun26_123614_split_a": "../Data/Output data/MC_sim_out- Date-Jun-26-2026 Time-12,36,14 - standard-run - inputs-dicom-194_mr-adc-0_mr-t2-0_rtdose-2_rtplan-2_rtstruct-2_us-2",
    "jun26_142500_split_b": "../Data/Output data/MC_sim_out- Date-Jun-26-2026 Time-14,25,00 - standard-run - inputs-dicom-263_mr-adc-1_mr-t2-0_rtdose-2_rtplan-2_rtstruct-2_us-2"
  },
  "paths": {
    "jun25_205540_patient_runner": "../Data/Output data/MC_sim_out- Date-Jun-25-2026 Time-20,55,40 - standard-run - inputs-dicom-457_mr-adc-1_mr-t2-0_rtdose-4_rtplan-4_rtstruct-4_us-4/patient_scientific_runner",
    "jun26_123614_patient_runner": "../Data/Output data/MC_sim_out- Date-Jun-26-2026 Time-12,36,14 - standard-run - inputs-dicom-194_mr-adc-0_mr-t2-0_rtdose-2_rtplan-2_rtstruct-2_us-2/patient_scientific_runner",
    "jun26_142500_patient_runner": "../Data/Output data/MC_sim_out- Date-Jun-26-2026 Time-14,25,00 - standard-run - inputs-dicom-263_mr-adc-1_mr-t2-0_rtdose-2_rtplan-2_rtstruct-2_us-2/patient_scientific_runner"
  },
  "run_groups": {
    "jun25_intrarun_patient_runner_parity": {
      "description": "Assemble retained Jun25 patient-runner artifacts, then compare assembled cohort tables against the same run's legacy/oracle cohort output.",
      "enabled": true,
      "jobs": [
        {
          "name": "assemble_patient_runner_cohort",
          "script": "post_run_cohort_assembly",
          "patient_runner_output_path": "jun25_205540_patient_runner"
        },
        {
          "name": "patient_runner_parity_vs_legacy",
          "script": "compare_patient_runner_parity",
          "legacy_output_run": "jun25_205540_single_shot",
          "patient_runner_output_path": "jun25_205540_patient_runner",
          "output_dir": "validation_outputs/jun25_205540/patient_runner_parity"
        }
      ]
    },
    "jun25_full_vs_split_reconstructed": {
      "description": "Compare the retained Jun25 single-shot patient-runner cohort surface to the same patient set reconstructed from retained Jun26 split runs.",
      "enabled": true,
      "jobs": [
        {
          "name": "full_vs_split_reconstructed",
          "script": "compare_reconstructed_cohort_runs",
          "reference_patient_runner_output_path": "jun25_205540_patient_runner",
          "split_patient_runner_outputs_paths": [
            "jun26_123614_patient_runner",
            "jun26_142500_patient_runner"
          ],
          "output_dir": "validation_outputs/jun25_205540/full_vs_split_reconstructed"
        }
      ]
    }
  }
}
